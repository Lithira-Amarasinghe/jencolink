# Copy this file to terraform.tfvars.
# Do not commit terraform.tfvars. It is gitignored.
#
# Do not put the Sanity project id or the Web3Forms key in this file.
# Terraform creates empty slots for them in Key Vault. You set the values
# in the Azure portal after apply.

# Terraform creates this resource group.
resource_group_name = "jencolink"

project_name = "jencolink"
environment  = "prod"

primary_location = "eastus2"
# frontend_location = "eastus2"  # SWA regions: centralus, eastus2, westus2, westeurope, eastasia
# keyvault_location = "eastus2"

# GitHub. Export a PAT as GITHUB_TOKEN before terraform apply.
# Fine-grained: this repo, Actions read and write.
# Leave github_repo_token unset. The provider reads GITHUB_TOKEN.
github_owner      = "Lithira-Amarasinghe"
github_repository = "jencolink"

# Application (client) ID of the jencolink-github-actions app registration.
# Apply grants that app its Azure roles and writes the OIDC GitHub secrets.
github_actions_client_id = ""

tags = {
  Project     = "Jencolink"
  Environment = "Production"
  ManagedBy   = "Terraform"
}
